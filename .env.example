# SiLo Environment Variables
# Copy this file to `.env.local` and fill in your values.

# MongoDB Connection (required for cross-device sync)
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Free tier: https://www.mongodb.com/cloud/atlas/register
VITE_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/silo?retryWrites=true&w=majority

# Optional live-AI explainers in the PYQ quiz. Point these at any
# OpenAI-compatible /chat/completions endpoint. Without them, the built-in
# template explainer is used.
# VITE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=sk-...
# VITE_AI_MODEL=gpt-4o-mini